msgstr "Routage des liens"

#: src/core/DefaultBrowserManager.cpp
#, kde-format
msgid ""
"%1 is not in the application database yet. Install it and run kbuildsycoca6, "
"then try again."
msgstr "%1 n'est pas encore dans la base de données des applications. Installez-le, lancez kbuildsycoca6 puis réessayez."

#: src/core/DefaultBrowserManager.cpp
#, kde-format
msgid "Could not save the previous browser associations."
msgstr "Impossible d'enregistrer les associations de navigateur précédentes."

#: src/core/DefaultBrowserManager.cpp
#, kde-format
msgid ""
"Could not write the browser associations; the previous handlers are retained."
msgstr "Impossible d'écrire les associations de navigateur ; les gestionnaires précédents sont conservés."

#: src/core/DefaultBrowserManager.cpp
#, kde-format
msgid ""
"Registered, but %1 also sets a default for http/https and takes precedence. "
"Lob will not receive links until that entry is removed."
msgstr "Enregistré, mais %1 définit également un gestionnaire par défaut pour http/https et a la priorité. Lob ne recevra aucun lien tant que cette entrée n'aura pas été supprimée."

#: src/core/DefaultBrowserManager.cpp
#, kde-format
msgid ""
"Could not restore the browser associations; recovery information is retained."
msgstr "Impossible de restaurer les associations de navigateur ; les informations de restauration sont conservées."

#: src/core/DefaultBrowserManager.cpp
#, kde-format
msgid ""
"Some browser associations could not be restored. Their recovery information "
"is retained."
msgstr "Certaines associations de navigateur n'ont pas pu être restaurées. Leurs informations de restauration sont conservées."

#: src/core/DefaultBrowserManager.cpp
#, kde-format
msgid ""
"No previous handler was recorded; set your browser from System Settings."
msgstr "Aucun gestionnaire précédent n'a été enregistré ; définissez votre navigateur dans la Configuration du système."

#: src/core/Launcher.cpp
#, kde-format
msgid "Refusing to launch %1: not a browser executable."
msgstr "Lancement de %1 refusé : ce n'est pas un exécutable de navigateur."

#: src/core/Launcher.cpp
#, kde-format
msgid "%1 does not support private browsing."
msgstr "%1 ne prend pas en charge la navigation privée."

#: src/core/Launcher.cpp
#, kde-format
msgid "Could not launch %1 (error %2)."
msgstr "Impossible de lancer %1 (erreur %2)."

#: src/core/Launcher.cpp
#, kde-format
msgid "Unsupported desktop launch command for %1."
msgstr "Commande de lancement non prise en charge pour %1."

#: src/core/Launcher.cpp
#, kde-format
msgid "Could not start %1."
msgstr "Impossible de démarrer %1."

#: src/core/RuleEngine.cpp
#, kde-format
msgctxt "what a rule matches; becomes %1 of a \"<match> -> <action>\" line"
msgid "host is %1"
msgstr "l'hôte est %1"

#: src/core/RuleEngine.cpp
#, kde-format
msgctxt "what a rule matches; becomes %1 of a \"<match> -> <action>\" line"
msgid "host is or ends in %1"
msgstr "l'hôte est %1 ou l'un de ses sous-domaines"

#: src/core/RuleEngine.cpp
#, kde-format
msgctxt "what a rule matches; becomes %1 of a \"<match> -> <action>\" line"
msgid "URL starts with %1"
msgstr "l'URL commence par %1"

#: src/core/RuleEngine.cpp
#, kde-format
msgctxt "what a rule matches; becomes %1 of a \"<match> -> <action>\" line"
msgid "URL matches /%1/"
msgstr "l'URL correspond à /%1/"

#: src/core/RuleEngine.cpp
#, kde-format
msgctxt "%1 is what the rule matches"
msgid "%1 → always ask"
msgstr "%1 → toujours demander"

#: src/core/RuleEngine.cpp
#, kde-format
msgctxt "%1 is what the rule matches"
msgid "%1 → copy instead of opening"
msgstr "%1 → copier au lieu d'ouvrir"

#: src/core/RuleEngine.cpp
#, kde-format
msgctxt "%1 is what the rule matches, %2 a browser or profile id"
msgid "%1 → open in %2 (private)"
msgstr "%1 → ouvrir dans %2 (privée)"

#: src/core/RuleEngine.cpp
#, kde-format
msgctxt "%1 is what the rule matches, %2 a browser or profile id"
msgid "%1 → open in %2"
msgstr "%1 → ouvrir dans %2"

#: src/core/RuleStore.cpp
#, kde-format
msgid "Cannot read rules.json; keeping the last valid configuration."
msgstr "Impossible de lire rules.json ; la dernière configuration valable est conservée."

#: src/core/RuleStore.cpp
#, kde-format
msgid "Invalid rules.json at byte %1; keeping the last valid configuration."
msgstr "rules.json non valable à l'octet %1 ; la dernière configuration valable est conservée."

#: src/core/RuleStore.cpp
#, kde-format
msgid "Cannot save until rules.json is readable and valid again."
msgstr "Enregistrement impossible tant que rules.json n'est pas de nouveau lisible et valable."

#: src/core/RuleStore.cpp
#, kde-format
msgid "Cannot create the Lob configuration directory."
msgstr "Impossible de créer le dossier de configuration de Lob."

#: src/core/RuleStore.cpp
#, kde-format
msgid "Another process is updating rules.json; try again."
msgstr "Un autre processus met à jour rules.json ; veuillez réessayer."

#: src/core/RuleStore.cpp
#, kde-format
msgid ""
"rules.json changed externally. Review the new configuration and try again."
msgstr "rules.json a été modifié extérieurement. Vérifiez la nouvelle configuration puis réessayez."

#: src/core/RuleStore.cpp
#, kde-format
msgid "Could not save rules.json: %1"
msgstr "Impossible d'enregistrer rules.json : %1"

#: src/core/UrlSanitizer.cpp
#, kde-format
msgid "Not a valid URL."
msgstr "URL non valable."

#: src/core/UrlSanitizer.cpp
#, kde-format
msgid "Only http and https URLs are routed (got '%1')."
msgstr "Seules les URL http et https sont routées (reçu « %1 »)."

#: src/core/UrlSanitizer.cpp
#, kde-format
msgid "URL has no host."
msgstr "L'URL n'a pas d'hôte."

#: src/core/UrlSanitizer.cpp
#, kde-format
msgid "URL contains embedded credentials."
msgstr "L'URL contient des identifiants intégrés."

#: src/main.cpp
#, kde-format
msgid "Routes links to the right browser"
msgstr "Achemine les liens vers le bon navigateur"

#: src/ui/PickerController.cpp
#, kde-format
msgid "The browser did not report back. The link may or may not have opened."
msgstr "Le navigateur n'a pas répondu. Le lien a peut-être été ouvert, ou non."

#: src/ui/PickerController.cpp
#, kde-format
msgid "Copying to clipboard"
msgstr "Copie dans le presse-papiers"

#: src/ui/PickerController.cpp
#, kde-format
msgid "Opening in %1 (private)"
msgstr "Ouverture dans %1 (privée)"

#: src/ui/PickerController.cpp
#, kde-format
msgid "Opening in %1"
msgstr "Ouverture dans %1"

#: src/ui/PickerController.cpp
#, kde-format
msgid "matched a rule"
msgstr "correspond à une règle"

#: src/ui/PickerController.cpp
#, kde-format
msgid "remembered for %1"
msgstr "mémorisé pour %1"

#: src/ui/PickerController.cpp
#, kde-format
msgid "default target"
msgstr "cible par défaut"

#: src/ui/PickerController.cpp
#, kde-format
msgctxt "%1 is a host name"
msgid "Remember for %1"
msgstr "Mémoriser pour %1"

#: src/ui/PickerController.cpp
#, kde-format
msgctxt "%1 is a domain name"
msgid "Remember for %1 and its subdomains"
msgstr "Mémoriser pour %1 et ses sous-domaines"

#: src/ui/PickerController.cpp
#, kde-format
msgctxt "%1 is a host and the first segment of a path"
msgid "Remember for everything under %1"
msgstr "Mémoriser pour tout ce qui est sous %1"

#: src/ui/PickerController.cpp
#, kde-format
msgid ""
"The configured browser or profile is unavailable or ambiguous. Choose a "
"browser for this link."
msgstr "Le navigateur ou le profil configuré est indisponible ou ambigu. Choisissez un navigateur pour ce lien."

#: qml/Picker.qml
msgid "via %1"
msgstr "via %1"

#: qml/Picker.qml
msgid "Opening browser…"
msgstr "Ouverture du navigateur…"

#: qml/Picker.qml
msgid "Nothing matches “%1”."
msgstr "Aucun résultat pour « %1 »."

#: qml/Picker.qml
msgid "No browsers found. Install a browser, then refresh the list."
msgstr "Aucun navigateur trouvé. Installez un navigateur puis actualisez la liste."

#: qml/Picker.qml
msgid "type to filter"
msgstr "saisissez pour filtrer"

#: qml/Picker.qml
msgctxt "matching targets of total"
msgid "%1 of %2"
msgstr "%1 sur %2"

#: qml/Picker.qml
msgid "Private browsing is unavailable for this target"
msgstr "La navigation privée est indisponible pour cette cible"

#: qml/Picker.qml
msgid "Update what I remember for %1"
msgstr "Mettre à jour ce qui est mémorisé pour %1"

#: qml/Picker.qml
msgid "Remember for %1"
msgstr "Mémoriser pour %1"

#: qml/Picker.qml
msgid "R for another scope"
msgstr "R pour une autre portée"

#: qml/Picker.qml
msgid "Private window"
msgstr "Fenêtre privée"

#: qml/Picker.qml
msgid "Any key or click to choose a different browser"
msgstr "N'importe quelle touche ou un clic pour choisir un autre navigateur"

#: qml/Picker.qml
msgid ""
"1–9 pick · Alt+P private · Alt+R remember · Alt+C copy · Esc clear filter"
msgstr "1–9 choisir · Alt+P privée · Alt+R mémoriser · Alt+C copier · Échap effacer le filtre"

#: qml/Picker.qml
msgid ""
"1–9 pick · / filter · P private · R remember · C copy · F5 refresh · Esc "
"cancel"
msgstr "1–9 choisir · / filtrer · P privée · R mémoriser · C copier · F5 actualiser · Échap annuler"

#: qml/Settings.qml
msgctxt "@title:window"
msgid "Lob Settings"
msgstr "Configuration de Lob"

#: qml/Settings.qml
msgid "Host"
msgstr "Hôte"

#: qml/Settings.qml
msgid "Domain"
msgstr "Domaine"

#: qml/Settings.qml
msgid "URL prefix"
msgstr "Préfixe d'URL"

#: qml/Settings.qml
msgid "Regular expression"
msgstr "Expression rationnelle"

#: qml/Settings.qml
msgid "Open"
msgstr "Ouvrir"

#: qml/Settings.qml
msgid "Always ask"
msgstr "Toujours demander"

#: qml/Settings.qml
msgid "Copy"
msgstr "Copier"

#: qml/Settings.qml
msgid "(none)"
msgstr "(aucune)"

#: qml/Settings.qml
msgctxt "browser, profile"
msgid "%1 — %2"
msgstr "%1 — %2"

#: qml/Settings.qml
msgctxt "a target id that is not installed"
msgid "%1 (not installed)"
msgstr "%1 (non installé)"

#: qml/Settings.qml
msgctxt "@title"
msgid "Lob"
msgstr "Lob"

#: qml/Settings.qml
msgid "Rules"
msgstr "Règles"

#: qml/Settings.qml
msgid ""
"The first rule that matches decides, so order matters. Rules always beat "
"remembered choices."
msgstr "La première règle qui correspond décide : l'ordre compte donc. Les règles l'emportent toujours sur les choix mémorisés."

#: qml/Settings.qml
msgid "A disabled rule stays in the file and decides nothing"
msgstr "Une règle désactivée reste dans le fichier et ne décide rien"

#: qml/Settings.qml
msgid "Match this earlier"
msgstr "Faire correspondre plus tôt"

#: qml/Settings.qml
msgid "Match this later"
msgstr "Faire correspondre plus tard"

#: qml/Settings.qml
msgid "Delete this rule"
msgstr "Supprimer cette règle"

#: qml/Settings.qml
msgid "Add Rule…"
msgstr "Ajouter une règle…"

#: qml/Settings.qml
msgid "Remembered choices"
msgstr "Choix mémorisés"

#: qml/Settings.qml
msgid ""
"Written by “remember” in the picker, narrowest first. Delete one to be asked "
"again."
msgstr "Écrits par « Mémoriser » dans le sélecteur, du plus précis au plus large. Supprimez-en un pour que la question soit posée de nouveau."

#: qml/Settings.qml
msgid "Forget this"
msgstr "Oublier ceci"

#: qml/Settings.qml
msgid "Other applications"
msgstr "Autres applications"

#: qml/Settings.qml
msgid ""
"These register for links without being browsers. They are hidden from the "
"picker until enabled here."
msgstr "Elles s'enregistrent pour les liens sans être des navigateurs. Elles restent masquées dans le sélecteur tant qu'elles ne sont pas activées ici."

#: qml/Settings.qml
msgid "Behaviour"
msgstr "Comportement"

#: qml/Settings.qml
msgid "Hold bar:"
msgstr "Barre d'attente :"

#: qml/Settings.qml
msgid "ms — zero opens immediately, with nothing to interrupt"
msgstr "ms — zéro ouvre immédiatement, sans rien à interrompre"

#: qml/Settings.qml
msgid "ms before a decided link opens"
msgstr "ms avant l'ouverture d'un lien déjà décidé"

#: qml/Settings.qml
msgid "Strip tracking parameters from links"
msgstr "Supprimer les paramètres de pistage des liens"

#: qml/Settings.qml
msgid "Everything here is %1, which stays hand-editable."
msgstr "Tout ceci se trouve dans %1, qui reste modifiable à la main."

#: qml/Settings.qml
msgctxt "@title:window"
msgid "Add Rule"
msgstr "Ajouter une règle"

#: qml/Settings.qml
msgid "Add"
msgstr "Ajouter"

