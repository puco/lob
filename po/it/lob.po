#: src/app/Controller.cpp src/app/TrayController.cpp src/main.cpp
#, kde-format
msgid "Lob"
msgstr "Lob"

#: src/app/TrayController.cpp
#, kde-format
msgid "Open Link in Clipboard…"
msgstr "Apri il collegamento negli appunti…"

#: src/app/TrayController.cpp
#, kde-format
msgid "Configure Lob…"
msgstr "Configura Lob…"

#: src/app/TrayController.cpp
#, kde-format
msgid "Pause Routing"
msgstr "Sospendi l'instradamento"

#: src/app/TrayController.cpp
#, kde-format
msgid "Quit"
msgstr "Esci"

#: src/app/TrayController.cpp
#, kde-format
msgid "Routing paused"
msgstr "Instradamento sospeso"

#: src/app/TrayController.cpp
#, kde-format
msgid "Routing links"
msgstr "Instradamento dei collegamenti"

#: src/core/DefaultBrowserManager.cpp
#, kde-format
msgid ""
"%1 is not in the application database yet. Install it and run kbuildsycoca6, "
"then try again."
msgstr "%1 non è ancora nella banca dati delle applicazioni. Installalo, esegui kbuildsycoca6 e riprova."

#: src/core/DefaultBrowserManager.cpp
#, kde-format
msgid "Could not save the previous browser associations."
msgstr "Impossibile salvare le associazioni precedenti del browser."

#: src/core/DefaultBrowserManager.cpp
#, kde-format
msgid ""
"Could not write the browser associations; the previous handlers are retained."
msgstr "Impossibile scrivere le associazioni del browser; i gestori precedenti sono stati mantenuti."

#: src/core/DefaultBrowserManager.cpp
#, kde-format
msgid ""
"Registered, but %1 also sets a default for http/https and takes precedence. "
"Lob will not receive links until that entry is removed."
msgstr "Registrato, ma anche %1 imposta un valore predefinito per http/https e ha la precedenza. Lob non riceverà collegamenti finché quella voce non sarà rimossa."

#: src/core/DefaultBrowserManager.cpp
#, kde-format
msgid ""
"Could not restore the browser associations; recovery information is retained."
msgstr "Impossibile ripristinare le associazioni del browser; le informazioni di ripristino sono state mantenute."

#: src/core/DefaultBrowserManager.cpp
#, kde-format
msgid ""
"Some browser associations could not be restored. Their recovery information "
"is retained."
msgstr "Alcune associazioni del browser non sono state ripristinate. Le relative informazioni di ripristino sono state mantenute."

#: src/core/DefaultBrowserManager.cpp
#, kde-format
msgid ""
"No previous handler was recorded; set your browser from System Settings."
msgstr "Non è stato registrato alcun gestore precedente; imposta il browser dalle Impostazioni di sistema."

#: src/core/Launcher.cpp
#, kde-format
msgid "Refusing to launch %1: not a browser executable."
msgstr "Avvio di %1 rifiutato: non è un eseguibile di un browser."

#: src/core/Launcher.cpp
#, kde-format
msgid "%1 does not support private browsing."
msgstr "%1 non supporta la navigazione privata."

#: src/core/Launcher.cpp
#, kde-format
msgid "Could not launch %1 (error %2)."
msgstr "Impossibile avviare %1 (errore %2)."

#: src/core/Launcher.cpp
#, kde-format
msgid "Unsupported desktop launch command for %1."
msgstr "Comando di avvio non supportato per %1."

#: src/core/Launcher.cpp
#, kde-format
msgid "Could not start %1."
msgstr "Impossibile avviare %1."

#: src/core/RuleEngine.cpp
#, kde-format
msgctxt "what a rule matches; becomes %1 of a \"<match> -> <action>\" line"
msgid "host is %1"
msgstr "l'host è %1"

#: src/core/RuleEngine.cpp
#, kde-format
msgctxt "what a rule matches; becomes %1 of a \"<match> -> <action>\" line"
msgid "host is or ends in %1"
msgstr "l'host è %1 o un suo sottodominio"

#: src/core/RuleEngine.cpp
#, kde-format
msgctxt "what a rule matches; becomes %1 of a \"<match> -> <action>\" line"
msgid "URL starts with %1"
msgstr "l'URL inizia con %1"

#: src/core/RuleEngine.cpp
#, kde-format
msgctxt "what a rule matches; becomes %1 of a \"<match> -> <action>\" line"
msgid "URL matches /%1/"
msgstr "l'URL corrisponde a /%1/"

#: src/core/RuleEngine.cpp
#, kde-format
msgctxt "%1 is what the rule matches"
msgid "%1 → always ask"
msgstr "%1 → chiedi sempre"

#: src/core/RuleEngine.cpp
#, kde-format
msgctxt "%1 is what the rule matches"
msgid "%1 → copy instead of opening"
msgstr "%1 → copia invece di aprire"

#: src/core/RuleEngine.cpp
#, kde-format
msgctxt "%1 is what the rule matches, %2 a browser or profile id"
msgid "%1 → open in %2 (private)"
msgstr "%1 → apri in %2 (privata)"

#: src/core/RuleEngine.cpp
#, kde-format
msgctxt "%1 is what the rule matches, %2 a browser or profile id"
msgid "%1 → open in %2"
msgstr "%1 → apri in %2"

#: src/core/RuleStore.cpp
#, kde-format
msgid "Cannot read rules.json; keeping the last valid configuration."
msgstr "Impossibile leggere rules.json; viene mantenuta l'ultima configurazione valida."

#: src/core/RuleStore.cpp
#, kde-format
msgid "Invalid rules.json at byte %1; keeping the last valid configuration."
msgstr "rules.json non valido al byte %1; viene mantenuta l'ultima configurazione valida."

#: src/core/RuleStore.cpp
#, kde-format
msgid "Cannot save until rules.json is readable and valid again."
msgstr "Impossibile salvare finché rules.json non sarà di nuovo leggibile e valido."

#: src/core/RuleStore.cpp
#, kde-format
msgid "Cannot create the Lob configuration directory."
msgstr "Impossibile creare la cartella di configurazione di Lob."

#: src/core/RuleStore.cpp
#, kde-format
msgid "Another process is updating rules.json; try again."
msgstr "Un altro processo sta aggiornando rules.json; riprova."

#: src/core/RuleStore.cpp
#, kde-format
msgid ""
"rules.json changed externally. Review the new configuration and try again."
msgstr "rules.json è stato modificato dall'esterno. Controlla la nuova configurazione e riprova."

#: src/core/RuleStore.cpp
#, kde-format
msgid "Could not save rules.json: %1"
msgstr "Impossibile salvare rules.json: %1"

#: src/core/UrlSanitizer.cpp
#, kde-format
msgid "Not a valid URL."
msgstr "URL non valido."

#: src/core/UrlSanitizer.cpp
#, kde-format
msgid "Only http and https URLs are routed (got '%1')."
msgstr "Vengono instradati solo URL http e https (ricevuto «%1»)."

#: src/core/UrlSanitizer.cpp
#, kde-format
msgid "URL has no host."
msgstr "L'URL non ha un host."

#: src/core/UrlSanitizer.cpp
#, kde-format
msgid "URL contains embedded credentials."
msgstr "L'URL contiene credenziali incorporate."

#: src/main.cpp
#, kde-format
msgid "Routes links to the right browser"
msgstr "Instrada i collegamenti al browser giusto"

#: src/ui/PickerController.cpp
#, kde-format
msgid "The browser did not report back. The link may or may not have opened."
msgstr "Il browser non ha risposto. Il collegamento potrebbe essere stato aperto oppure no."

#: src/ui/PickerController.cpp
#, kde-format
msgid "Copying to clipboard"
msgstr "Copia negli appunti"

#: src/ui/PickerController.cpp
#, kde-format
msgid "Opening in %1 (private)"
msgstr "Apertura in %1 (privata)"

#: src/ui/PickerController.cpp
#, kde-format
msgid "Opening in %1"
msgstr "Apertura in %1"

#: src/ui/PickerController.cpp
#, kde-format
msgid "matched a rule"
msgstr "corrisponde a una regola"

#: src/ui/PickerController.cpp
#, kde-format
msgid "remembered for %1"
msgstr "memorizzato per %1"

#: src/ui/PickerController.cpp
#, kde-format
msgid "default target"
msgstr "destinazione predefinita"

#: src/ui/PickerController.cpp
#, kde-format
msgctxt "%1 is a host name"
msgid "Remember for %1"
msgstr "Memorizza per %1"

#: src/ui/PickerController.cpp
#, kde-format
msgctxt "%1 is a domain name"
msgid "Remember for %1 and its subdomains"
msgstr "Memorizza per %1 e i suoi sottodomini"

#: src/ui/PickerController.cpp
#, kde-format
msgctxt "%1 is a host and the first segment of a path"
msgid "Remember for everything under %1"
msgstr "Memorizza per tutto ciò che sta sotto %1"

#: src/ui/PickerController.cpp
#, kde-format
msgid ""
"The configured browser or profile is unavailable or ambiguous. Choose a "
"browser for this link."
msgstr "Il browser o il profilo configurato non è disponibile o è ambiguo. Scegli un browser per questo collegamento."

#: qml/Picker.qml
msgid "via %1"
msgstr "tramite %1"

#: qml/Picker.qml
msgid "Opening browser…"
msgstr "Apertura del browser…"

#: qml/Picker.qml
msgid "Nothing matches “%1”."
msgstr "Nessun risultato per «%1»."

#: qml/Picker.qml
msgid "No browsers found. Install a browser, then refresh the list."
msgstr "Nessun browser trovato. Installa un browser, poi aggiorna l'elenco."

#: qml/Picker.qml
msgid "type to filter"
msgstr "digita per filtrare"

#: qml/Picker.qml
msgctxt "matching targets of total"
msgid "%1 of %2"
msgstr "%1 di %2"

#: qml/Picker.qml
msgid "Private browsing is unavailable for this target"
msgstr "La navigazione privata non è disponibile per questa destinazione"

#: qml/Picker.qml
msgid "Update what I remember for %1"
msgstr "Aggiorna ciò che è memorizzato per %1"

#: qml/Picker.qml
msgid "Remember for %1"
msgstr "Memorizza per %1"

#: qml/Picker.qml
msgid "R for another scope"
msgstr "R per un altro ambito"

#: qml/Picker.qml
msgid "Private window"
msgstr "Finestra privata"

#: qml/Picker.qml
msgid "Any key or click to choose a different browser"
msgstr "Premi un tasto o fai clic per scegliere un altro browser"

#: qml/Picker.qml
msgid ""
"1–9 pick · Alt+P private · Alt+R remember · Alt+C copy · Esc clear filter"
msgstr "1–9 scegli · Alt+P privata · Alt+R memorizza · Alt+C copia · Esc cancella filtro"

#: qml/Picker.qml
msgid ""
"1–9 pick · / filter · P private · R remember · C copy · F5 refresh · Esc "
"cancel"
msgstr "1–9 scegli · / filtra · P privata · R memorizza · C copia · F5 aggiorna · Esc annulla"

#: qml/Settings.qml
msgctxt "@title:window"
msgid "Lob Settings"
msgstr "Impostazioni di Lob"

#: qml/Settings.qml
msgid "Host"
msgstr "Host"

#: qml/Settings.qml
msgid "Domain"
msgstr "Dominio"

#: qml/Settings.qml
msgid "URL prefix"
msgstr "Prefisso URL"

#: qml/Settings.qml
msgid "Regular expression"
msgstr "Espressione regolare"

#: qml/Settings.qml
msgid "Open"
msgstr "Apri"

#: qml/Settings.qml
msgid "Always ask"
msgstr "Chiedi sempre"

#: qml/Settings.qml
msgid "Copy"
msgstr "Copia"

#: qml/Settings.qml
msgid "(none)"
msgstr "(nessuna)"

#: qml/Settings.qml
msgctxt "browser, profile"
msgid "%1 — %2"
msgstr "%1 — %2"

#: qml/Settings.qml
msgctxt "a target id that is not installed"
msgid "%1 (not installed)"
msgstr "%1 (non installato)"

#: qml/Settings.qml
msgctxt "@title"
msgid "Lob"
msgstr "Lob"

#: qml/Settings.qml
msgid "Rules"
msgstr "Regole"

#: qml/Settings.qml
msgid ""
"The first rule that matches decides, so order matters. Rules always beat "
"remembered choices."
msgstr "Decide la prima regola che corrisponde, quindi l'ordine conta. Le regole hanno sempre la precedenza sulle scelte memorizzate."

#: qml/Settings.qml
msgid "A disabled rule stays in the file and decides nothing"
msgstr "Una regola disattivata resta nel file e non decide nulla"

#: qml/Settings.qml
msgid "Match this earlier"
msgstr "Verifica prima"

#: qml/Settings.qml
msgid "Match this later"
msgstr "Verifica dopo"

#: qml/Settings.qml
msgid "Delete this rule"
msgstr "Elimina questa regola"

#: qml/Settings.qml
msgid "Add Rule…"
msgstr "Aggiungi regola…"

#: qml/Settings.qml
msgid "Remembered choices"
msgstr "Scelte memorizzate"

#: qml/Settings.qml
msgid ""
"Written by “remember” in the picker, narrowest first. Delete one to be asked "
"again."
msgstr "Scritte da «Memorizza» nel selettore, dalla più specifica. Eliminane una per essere interrogato di nuovo."

#: qml/Settings.qml
msgid "Forget this"
msgstr "Dimentica"

#: qml/Settings.qml
msgid "Other applications"
msgstr "Altre applicazioni"

#: qml/Settings.qml
msgid ""
"These register for links without being browsers. They are hidden from the "
"picker until enabled here."
msgstr "Si registrano per i collegamenti pur non essendo browser. Restano nascoste nel selettore finché non vengono attivate qui."

#: qml/Settings.qml
msgid "Behaviour"
msgstr "Comportamento"

#: qml/Settings.qml
msgid "Hold bar:"
msgstr "Barra di attesa:"

#: qml/Settings.qml
msgid "ms — zero opens immediately, with nothing to interrupt"
msgstr "ms — zero apre subito, senza nulla da interrompere"

#: qml/Settings.qml
msgid "ms before a decided link opens"
msgstr "ms prima che un collegamento deciso venga aperto"

#: qml/Settings.qml
msgid "Strip tracking parameters from links"
msgstr "Rimuovi i parametri di tracciamento dai collegamenti"

#: qml/Settings.qml
msgid "Everything here is %1, which stays hand-editable."
msgstr "Tutto questo si trova in %1, che resta modificabile a mano."

#: qml/Settings.qml
msgctxt "@title:window"
msgid "Add Rule"
msgstr "Aggiungi regola"

#: qml/Settings.qml
msgid "Add"
msgstr "Aggiungi"

