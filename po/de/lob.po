#: src/core/DefaultBrowserManager.cpp
#, kde-format
msgid ""
"%1 is not in the application database yet. Install it and run kbuildsycoca6, "
"then try again."
msgstr "%1 ist noch nicht in der Anwendungsdatenbank. Installieren Sie es, führen Sie kbuildsycoca6 aus und versuchen Sie es erneut."

#: src/core/DefaultBrowserManager.cpp
#, kde-format
msgid "Could not save the previous browser associations."
msgstr "Die vorherigen Browser-Zuordnungen konnten nicht gespeichert werden."

#: src/core/DefaultBrowserManager.cpp
#, kde-format
msgid ""
"Could not write the browser associations; the previous handlers are retained."
msgstr "Die Browser-Zuordnungen konnten nicht geschrieben werden; die vorherigen Zuordnungen bleiben erhalten."

#: src/core/DefaultBrowserManager.cpp
#, kde-format
msgid ""
"Registered, but %1 also sets a default for http/https and takes precedence. "
"Lob will not receive links until that entry is removed."
msgstr "Registriert, aber %1 legt ebenfalls einen Standard für http/https fest und hat Vorrang. Lob erhält keine Links, solange dieser Eintrag besteht."

#: src/core/DefaultBrowserManager.cpp
#, kde-format
msgid ""
"Could not restore the browser associations; recovery information is retained."
msgstr "Die Browser-Zuordnungen konnten nicht wiederhergestellt werden; die Wiederherstellungsdaten bleiben erhalten."

#: src/core/DefaultBrowserManager.cpp
#, kde-format
msgid ""
"Some browser associations could not be restored. Their recovery information "
"is retained."
msgstr "Einige Browser-Zuordnungen konnten nicht wiederhergestellt werden. Ihre Wiederherstellungsdaten bleiben erhalten."

#: src/core/DefaultBrowserManager.cpp
#, kde-format
msgid ""
"No previous handler was recorded; set your browser from System Settings."
msgstr "Es wurde keine vorherige Zuordnung gespeichert; legen Sie Ihren Browser in den Systemeinstellungen fest."

#: src/core/Launcher.cpp
#, kde-format
msgid "Refusing to launch %1: not a browser executable."
msgstr "%1 wird nicht gestartet: keine Browser-Programmdatei."

#: src/core/Launcher.cpp
#, kde-format
msgid "%1 does not support private browsing."
msgstr "%1 unterstützt keinen privaten Modus."

#: src/core/Launcher.cpp
#, kde-format
msgid "Could not launch %1 (error %2)."
msgstr "%1 konnte nicht gestartet werden (Fehler %2)."

#: src/core/Launcher.cpp
#, kde-format
msgid "Unsupported desktop launch command for %1."
msgstr "Nicht unterstützter Startbefehl für %1."

#: src/core/Launcher.cpp
#, kde-format
msgid "Could not start %1."
msgstr "%1 konnte nicht gestartet werden."

#: src/core/RuleEngine.cpp
#, kde-format
msgctxt "what a rule matches; becomes %1 of a \"<match> -> <action>\" line"
msgid "host is %1"
msgstr "Host ist %1"

#: src/core/RuleEngine.cpp
#, kde-format
msgctxt "what a rule matches; becomes %1 of a \"<match> -> <action>\" line"
msgid "host is or ends in %1"
msgstr "Host ist %1 oder eine Subdomain davon"

#: src/core/RuleEngine.cpp
#, kde-format
msgctxt "what a rule matches; becomes %1 of a \"<match> -> <action>\" line"
msgid "URL starts with %1"
msgstr "URL beginnt mit %1"

#: src/core/RuleEngine.cpp
#, kde-format
msgctxt "what a rule matches; becomes %1 of a \"<match> -> <action>\" line"
msgid "URL matches /%1/"
msgstr "URL passt auf /%1/"

#: src/core/RuleEngine.cpp
#, kde-format
msgctxt "%1 is what the rule matches"
msgid "%1 → always ask"
msgstr "%1 → immer fragen"

#: src/core/RuleEngine.cpp
#, kde-format
msgctxt "%1 is what the rule matches"
msgid "%1 → copy instead of opening"
msgstr "%1 → kopieren statt öffnen"

#: src/core/RuleEngine.cpp
#, kde-format
msgctxt "%1 is what the rule matches, %2 a browser or profile id"
msgid "%1 → open in %2 (private)"
msgstr "%1 → in %2 öffnen (privat)"

#: src/core/RuleEngine.cpp
#, kde-format
msgctxt "%1 is what the rule matches, %2 a browser or profile id"
msgid "%1 → open in %2"
msgstr "%1 → in %2 öffnen"

#: src/core/RuleStore.cpp
#, kde-format
msgid "Cannot read rules.json; keeping the last valid configuration."
msgstr "rules.json kann nicht gelesen werden; die letzte gültige Konfiguration bleibt aktiv."

#: src/core/RuleStore.cpp
#, kde-format
msgid "Invalid rules.json at byte %1; keeping the last valid configuration."
msgstr "Ungültige rules.json bei Byte %1; die letzte gültige Konfiguration bleibt aktiv."

#: src/core/RuleStore.cpp
#, kde-format
msgid "Cannot save until rules.json is readable and valid again."
msgstr "Speichern ist nicht möglich, bis rules.json wieder lesbar und gültig ist."

#: src/core/RuleStore.cpp
#, kde-format
msgid "Cannot create the Lob configuration directory."
msgstr "Der Konfigurationsordner von Lob kann nicht erstellt werden."

#: src/core/RuleStore.cpp
#, kde-format
msgid "Another process is updating rules.json; try again."
msgstr "Ein anderer Prozess ändert gerade rules.json; versuchen Sie es erneut."

#: src/core/RuleStore.cpp
#, kde-format
msgid ""
"rules.json changed externally. Review the new configuration and try again."
msgstr "rules.json wurde extern geändert. Prüfen Sie die neue Konfiguration und versuchen Sie es erneut."

#: src/core/RuleStore.cpp
#, kde-format
msgid "Could not save rules.json: %1"
msgstr "rules.json konnte nicht gespeichert werden: %1"

#: src/core/UrlSanitizer.cpp
#, kde-format
msgid "Not a valid URL."
msgstr "Keine gültige URL."

#: src/core/UrlSanitizer.cpp
#, kde-format
msgid "Only http and https URLs are routed (got '%1')."
msgstr "Es werden nur http- und https-URLs weitergeleitet (erhalten: „%1“)."

#: src/core/UrlSanitizer.cpp
#, kde-format
msgid "URL has no host."
msgstr "Die URL hat keinen Host."

#: src/core/UrlSanitizer.cpp
#, kde-format
msgid "URL contains embedded credentials."
msgstr "Die URL enthält eingebettete Zugangsdaten."

#: src/main.cpp
#, kde-format
msgid "Routes links to the right browser"
msgstr "Leitet Links an den richtigen Browser weiter"

#: src/ui/PickerController.cpp
#, kde-format
msgid "The browser did not report back. The link may or may not have opened."
msgstr "Der Browser hat sich nicht zurückgemeldet. Der Link wurde möglicherweise geöffnet."

#: src/ui/PickerController.cpp
#, kde-format
msgid "Copying to clipboard"
msgstr "Wird in die Zwischenablage kopiert"

#: src/ui/PickerController.cpp
#, kde-format
msgid "Opening in %1 (private)"
msgstr "Wird in %1 geöffnet (privat)"

#: src/ui/PickerController.cpp
#, kde-format
msgid "Opening in %1"
msgstr "Wird in %1 geöffnet"

#: src/ui/PickerController.cpp
#, kde-format
msgid "matched a rule"
msgstr "eine Regel trifft zu"

#: src/ui/PickerController.cpp
#, kde-format
msgid "remembered for %1"
msgstr "für %1 gemerkt"

#: src/ui/PickerController.cpp
#, kde-format
msgid "default target"
msgstr "Standardziel"

#: src/ui/PickerController.cpp
#, kde-format
msgctxt "%1 is a host name"
msgid "Remember for %1"
msgstr "Für %1 merken"

#: src/ui/PickerController.cpp
#, kde-format
msgctxt "%1 is a domain name"
msgid "Remember for %1 and its subdomains"
msgstr "Für %1 und alle Subdomains merken"

#: src/ui/PickerController.cpp
#, kde-format
msgctxt "%1 is a host and the first segment of a path"
msgid "Remember for everything under %1"
msgstr "Für alles unter %1 merken"

#: src/ui/PickerController.cpp
#, kde-format
msgid ""
"The configured browser or profile is unavailable or ambiguous. Choose a "
"browser for this link."
msgstr "Der eingestellte Browser oder das Profil ist nicht verfügbar oder nicht eindeutig. Wählen Sie einen Browser für diesen Link."

#: qml/Picker.qml
msgid "via %1"
msgstr "über %1"

#: qml/Picker.qml
msgid "Opening browser…"
msgstr "Browser wird geöffnet …"

#: qml/Picker.qml
msgid "Nothing matches “%1”."
msgstr "Nichts passt zu „%1“."

#: qml/Picker.qml
msgid "No browsers found. Install a browser, then refresh the list."
msgstr "Keine Browser gefunden. Installieren Sie einen Browser und aktualisieren Sie die Liste."

#: qml/Picker.qml
msgid "type to filter"
msgstr "zum Filtern tippen"

#: qml/Picker.qml
msgctxt "matching targets of total"
msgid "%1 of %2"
msgstr "%1 von %2"

#: qml/Picker.qml
msgid "Private browsing is unavailable for this target"
msgstr "Privates Surfen ist für dieses Ziel nicht verfügbar"

#: qml/Picker.qml
msgid "Update what I remember for %1"
msgstr "Gemerkte Auswahl für %1 aktualisieren"

#: qml/Picker.qml
msgid "Remember for %1"
msgstr "Für %1 merken"

#: qml/Picker.qml
msgid "R for another scope"
msgstr "R für einen anderen Bereich"

#: qml/Picker.qml
msgid "Private window"
msgstr "Privates Fenster"

#: qml/Picker.qml
msgid "Any key or click to choose a different browser"
msgstr "Beliebige Taste oder Klick, um einen anderen Browser zu wählen"

#: qml/Picker.qml
msgid ""
"1–9 pick · Alt+P private · Alt+R remember · Alt+C copy · Esc clear filter"
msgstr "1–9 wählen · Alt+P privat · Alt+R merken · Alt+C kopieren · Esc Filter löschen"

#: qml/Picker.qml
msgid ""
"1–9 pick · / filter · P private · R remember · C copy · F5 refresh · Esc "
"cancel"
msgstr "1–9 wählen · / filtern · P privat · R merken · C kopieren · F5 aktualisieren · Esc abbrechen"

#: qml/Settings.qml
