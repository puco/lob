[Desktop Entry]
Type=Application
Name=Lob
GenericName=Link Router
GenericName[de]=Link-Router
GenericName[fr]=Routeur de liens
GenericName[it]=Instradatore di collegamenti
Comment=Choose which browser opens each link
Comment[de]=Auswählen, welcher Browser welchen Link öffnet
Comment[fr]=Choisir quel navigateur ouvre chaque lien
Comment[it]=Scegli quale browser apre ciascun collegamento
Exec=@LOB_BIN@ %u
TryExec=@LOB_BIN@
Icon=io.github.puco.lob
Terminal=false
StartupNotify=true
DBusActivatable=true
Categories=Network;Qt;KDE;
MimeType=x-scheme-handler/http;x-scheme-handler/https;
Keywords=browser;link;url;open with;default browser;
Keywords[de]=Browser;Link;URL;Öffnen mit;Standardbrowser;
Keywords[fr]=navigateur;lien;URL;ouvrir avec;navigateur par défaut;
Keywords[it]=browser;collegamento;link;URL;apri con;browser predefinito;
