[Unit]
Description=Lob link router
Documentation=https://github.com/puco/lob
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=dbus
BusName=io.github.puco.lob
ExecStart=@LOB_BIN@ --daemon
Restart=on-failure
RestartSec=2
Slice=app.slice

[Install]
WantedBy=graphical-session.target
